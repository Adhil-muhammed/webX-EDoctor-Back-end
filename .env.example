# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── PostgreSQL (Docker) ──────────────────────────────────────────────────────
POSTGRES_USER=edoctor
POSTGRES_PASSWORD=edoctor_secret
POSTGRES_DB=edoctor_db
POSTGRES_PORT=5432

# ─── Prisma ───────────────────────────────────────────────────────────────────
# Standard PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"
